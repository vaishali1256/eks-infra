# Terraform working directories
.terraform/
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files (keep sensitive data out of version control)
*.tfvars
*.tfvars.json

# CLI configuration
.terraformrc
terraform.rc

# OS and editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
